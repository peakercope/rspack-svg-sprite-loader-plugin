{
  "name": "rspack-svg-sprite-loader-plugin",
  "description": "SVG Sprite Plugin for Rspack",
  "version": "0.3.0",
  "type": "module",
  "author": "peakercope <peakercope@gmail.com> (https://github.com/peakercope)",
  "license": "MIT",
  "homepage": "https://github.com/peakercope/rspack-svg-sprite-loader-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakercope/rspack-svg-sprite-loader-plugin.git"
  },
  "keywords": [
    "svg",
    "sprite",
    "rspack",
    "plugin",
    "rspack-svg-sprite-loader-plugin"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch ./src",
    "build": "tsc && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write",
    "lint": "biome ci",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "^2.31.1",
    "@rspack/core": "^2.1.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@rspack/core": "^2.1.5"
  },
  "packageManager": "yarn@4.17.1"
}
